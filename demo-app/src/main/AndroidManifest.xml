<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      CODJIA fonctionne entièrement hors ligne : aucune permission n'est demandée.
      - Galerie : MediaStore (Android 10+) n'exige aucune permission pour ses propres vidéos.
      - Musique importée : sélecteur de fichiers du système (accès limité au fichier choisi).
      On retire explicitement INTERNET et l'accès réseau au cas où une bibliothèque les ajouterait
      par fusion de manifeste : l'appli ne peut ni envoyer ni recevoir de données.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Codjia"
        tools:targetApi="31">
        <!-- Seule l'activité de lancement est exportée ; elle ne lit aucune donnée d'Intent extérieur. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
