<?xml version="1.0" encoding="utf-8"?>
<!-- L'appli n'a pas accès au réseau ; si cela change un jour, seul HTTPS avec les AC du système sera admis. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
