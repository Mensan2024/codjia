<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ : sans cette déclaration, l'appli ne « voit » pas le moteur de synthèse vocale.
         Ce n'est pas une permission : aucun accès réseau ni aux données. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
